{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "monitored-tools": {
      "type": "local",
      "command": [
        "/absolute/path/to/venv/bin/mcp-otel-gateway",
        "--config",
        "/absolute/path/to/upstream.json"
      ],
      "environment": {
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4318"
      },
      "enabled": true
    }
  }
}
