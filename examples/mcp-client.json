{
  "mcpServers": {
    "monitored-tools": {
      "command": "/absolute/path/to/venv/bin/mcp-otel-gateway",
      "args": ["--config", "/absolute/path/to/upstream.json"],
      "env": {
        "OTEL_SERVICE_NAME": "agent-tools",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4318"
      }
    }
  }
}
